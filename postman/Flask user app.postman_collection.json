{
  "info": {
    "_postman_id": "11111111-1111-4111-8111-111111111111",
    "name": "Flask user app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/users"
      }
    },
    {
      "name": "Get One User",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/users/{{user_id}}"
      }
    },
    {
      "name": "Add User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"User was added\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "if (response.user_id) {",
              "    pm.environment.set(\"user_id\", response.user_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Fatima Bazzoun\",\n  \"email\": \"fatima@example.com\",\n  \"phone\": \"03123456\",\n  \"address\": \"Beirut\",\n  \"country\": \"Lebanon\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/users/add"
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": {{user_id}},\n  \"name\": \"Fatima Bazzoun\",\n  \"email\": \"fatima.updated@example.com\",\n  \"phone\": \"03999999\",\n  \"address\": \"Beirut\",\n  \"country\": \"Lebanon\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/users/update"
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/users/delete/{{user_id}}"
      }
    }
  ]
}
